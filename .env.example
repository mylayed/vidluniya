# Скопіюйте цей файл у .env і заповніть (Project Settings → API у Supabase).
# EXPO_PUBLIC_* потрапляє в клієнтський код, тому тут лише публічні значення.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret-ключ (sb_secret_...) сюди НЕ додавати: він лише для Edge Functions
# і зберігається в Supabase secrets.
